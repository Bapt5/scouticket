# Better Auth + PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/scoutreso
POSTGRES_DB=scoutreso
POSTGRES_USER=scoutreso
POSTGRES_PASSWORD=scoutreso
BETTER_AUTH_SECRET=generate_a_long_random_secret
# Secret distinct pour pseudonymiser les identifiants dans les journaux d'audit
AUDIT_LOG_SECRET=generate_a_different_long_random_secret
# Certificat de scellement des signatures électroniques des notes de frais signées
# (PKCS#12 en base64 et son mot de passe) : à générer avec `pnpm ndf:certificat`
NDF_SCELLEMENT_P12_BASE64=
NDF_SCELLEMENT_P12_MOT_DE_PASSE=
# Site de documentation uniquement (lue au build) : empreinte SHA-256 du certificat, non secrète,
# affichée sur la page « Vérifier une note de frais signée »
# NDF_SCELLEMENT_EMPREINTE_SHA256=
# Développement local uniquement : chemin vers un Chrome/Chromium installé sur la machine,
# utilisé pour générer le PDF des notes de frais signées (@sparticuz/chromium ne fonctionne
# que sur Linux, comme en production sur Vercel). Laisser vide en production.
# Exemple Windows : C:\Program Files\Google\Chrome\Application\chrome.exe
# Exemple macOS   : /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Exemple Linux   : /usr/bin/chromium ou /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URL publique de l'application, utilisée dans les liens envoyés par e-mail
APP_URL=

# Active la page de maintenance et désactive les API (true ou false)
MAINTENANCE_MODE=false

# Mesure d'audience (optionnelle) : laissez vide pour la désactiver.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# SMTP Configuration (Generic - works with any email provider)
# Configuration serveur SMTP (fonctionne avec n'importe quel fournisseur d'email)

# Host SMTP de votre fournisseur
SMTP_HOST=your-smtp_host

# Port SMTP (587 pour TLS, 465 pour SSL, 25 pour non-sécurisé)
SMTP_PORT=your-smtp_port

# Utiliser SSL/TLS (true pour port 465, false pour port 587)
SMTP_SECURE=your-smtp_secure

# Identifiants SMTP
SMTP_USER=your-smtp_user
SMTP_PASSWORD=your-smtp_password

# Optionnel : adresse de l'expéditeur (utile si SMTP_USER ≠ adresse email, ex : Resend)
SMTP_FROM=your-smtp_from
# Nom utilisé pour tous les e-mails envoyés par l'application
SMTP_FROM_NAME=your-smtp_from_name
# Optionnel : compatibilité descendante si vous préférez séparer nom/adresse
SMTP_FROM_EMAIL=your-smtp_from_email

# GMAIL_APP_PASSWORD=your-# gmail_app_password
# L'adresse de trésorerie est désormais renseignée et validée par chaque groupe
# dans l'application. Ne pas ajouter d'adresse globale ici.

# Exemples de configuration pour différents fournisseurs :
#
# Gmail :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-#   smtp_user
#   SMTP_PASSWORD=your-#   smtp_password
#
# Office 365 :
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-#   smtp_user
#   SMTP_PASSWORD=your-#   smtp_password
#
# Serveur SMTP personnalisé :
#   SMTP_HOST=your-#   smtp_host
#   SMTP_PORT=your-#   smtp_port
#   SMTP_SECURE=your-#   smtp_secure
#   SMTP_USER=your-#   smtp_user
#   SMTP_PASSWORD=your-#   smtp_password
